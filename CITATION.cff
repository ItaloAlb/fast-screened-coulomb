    family-names: "Albuquerque"
    orcid: "https://orcid.org/0009-0007-3550-1787"
    affiliation: "Universidade Federal do Ceará (UFC)"
keywords:
  - "screened Coulomb interaction"
  - "van der Waals heterostructures"
  - "electrostatic transfer matrix"
  - "excitons"
  - "dielectric screening"
references:
  - type: article
    title: "Electrostatics of electron-hole interactions in van der Waals heterostructures"
    authors:
      - family-names: "Cavalcante"
        given-names: "L. S. R."
      - family-names: "Chaves"
        given-names: "A."
